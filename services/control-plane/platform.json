{
  "name": "platform",
  "description": "The platform control plane: console, API, deployer and telemetry.",
  "web": {
    "server": "src/server.ts",
    "static": "web/dist",
    "build": "pnpm web:build",
    "dev": {
      "command": "pnpm web:dev",
      "port": 5173
    },
    "spa": true,
    "serverRoutes": ["/v1/", "/auth/"],
    "timeoutSeconds": 120
  },
  "worker": {
    "entry": "src/worker.ts",
    "timeoutSeconds": 900,
    "memoryMb": 1024
  },
  "auth": false,
  "crons": {
    "pinger": "*/5 * * * *",
    "watchdog": "*/5 * * * *",
    "cost": "0 7 * * *",
    "reaper": "0 8 * * *"
  }
}
