{
  "name": "@ericminassian/plat",
  "version": "0.3.0",
  "description": "CLI for the platform: init, dev (AWS Emulator), build, deploy, logs, metrics, errors, data.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric-minassian/platform.git",
    "directory": "packages/cli"
  },
  "bin": {
    "plat": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "bin": {
      "plat": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "template"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-template.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-eventbridge": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@ericminassian/platform": "workspace:*",
    "@ericminassian/platform-core": "workspace:*",
    "@ericminassian/platform-engine": "workspace:*",
    "commander": "^15.1.0",
    "cron-parser": "^5.10.6",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.15"
  }
}
