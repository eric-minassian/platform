{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/eric-minassian/platform/main/packages/core/platform.schema.json",
  "title": "platform.json",
  "description": "What an app needs from the platform. See docs/DESIGN.md.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9]|-(?!-)){1,28}[a-z0-9]$"
    },
    "description": {
      "type": "string",
      "maxLength": 200
    },
    "web": {
      "type": "object",
      "properties": {
        "server": {
          "type": "string"
        },
        "static": {
          "type": "string"
        },
        "build": {
          "type": "string"
        },
        "dev": {
          "type": "object",
          "properties": {
            "command": {
              "type": "string"
            },
            "port": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": ["command", "port"]
        },
        "spa": {
          "default": true,
          "type": "boolean"
        },
        "serverRoutes": {
          "default": ["/api/"],
          "type": "array",
          "items": {
            "type": "string",
            "format": "starts_with",
            "pattern": "^\\/.*"
          }
        },
        "timeoutSeconds": {
          "default": 30,
          "type": "integer",
          "minimum": 3,
          "maximum": 900
        },
        "concurrency": {
          "default": 64,
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "entry": {
          "default": "src/worker.ts",
          "type": "string"
        },
        "timeoutSeconds": {
          "default": 60,
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "memoryMb": {
          "default": 512,
          "type": "integer",
          "minimum": 128,
          "maximum": 10240
        }
      }
    },
    "auth": {
      "default": false,
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "required": {
              "default": false,
              "type": "boolean"
            }
          }
        }
      ]
    },
    "db": {
      "default": false,
      "type": "boolean"
    },
    "queues": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!.*--)[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "batchSize": {
            "default": 10,
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "visibilityTimeoutSeconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 43200
          },
          "maxReceiveCount": {
            "default": 5,
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "concurrency": {
            "type": "integer",
            "minimum": 2,
            "maximum": 1000
          }
        }
      }
    },
    "events": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z][a-zA-Z0-9._:-]{0,63}$"
      }
    },
    "crons": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?!.*--)[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "schedule": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              }
            },
            "required": ["schedule"]
          }
        ]
      }
    },
    "storage": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^(?!.*--)[a-z](?:[a-z0-9-]{0,18}[a-z0-9])?$"
      }
    },
    "secrets": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      }
    },
    "env": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": ["name"]
}
