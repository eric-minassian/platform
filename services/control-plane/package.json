{
  "name": "@ericminassian/platform-control-plane",
  "version": "0.1.0",
  "private": true,
  "description": "The platform's control plane: API, console, deployer and telemetry, deployed as a platform app.",
  "type": "module",
  "exports": {
    "./records": "./src/records.ts"
  },
  "scripts": {
    "typecheck": "effect-tsgo tsc --noEmit && effect-tsgo tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "build": "plat build",
    "dev": "plat dev",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "api:dev": "node src/dev.ts",
    "web:demo": "node src/demo/server.ts",
    "web:shots": "node web/shots.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.1169.0",
