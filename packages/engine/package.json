{
  "name": "@ericminassian/platform-engine",
  "version": "0.4.0",
  "description": "Idempotent AWS SDK drivers that provision and deploy platform stages (no CloudFormation).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric-minassian/platform.git",
    "directory": "packages/engine"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-appsync": "^3.1169.0",
    "@aws-sdk/client-cloudfront-keyvaluestore": "^3.1169.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1169.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-ecr": "^3.1169.0",
    "@aws-sdk/client-ecs": "^3.1169.0",
    "@aws-sdk/client-eventbridge": "^3.1169.0",
    "@aws-sdk/client-iam": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-lambda-web": "^3.1169.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-scheduler": "^3.1169.0",
    "@aws-sdk/client-sesv2": "^3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/client-sts": "^3.1169.0",
    "@aws-sdk/signature-v4a": "^3.1138.0",
    "@ericminassian/platform-core": "workspace:*",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/node-http-handler": "^4.14.2",
    "@smithy/signature-v4": "^5.7.5",
    "fflate": "^0.8.3"
  }
}
