{
  "name": "@ericminassian/platform",
  "version": "0.3.0",
  "description": "Runtime SDK for apps on the platform, built on Effect: db, queues, events, storage, secrets, auth, realtime, metrics.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric-minassian/platform.git",
    "directory": "packages/sdk"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api.ts",
    "./client": "./src/client.ts",
    "./config": "./src/config.ts",
    "./server": "./src/runtime/server.ts",
    "./worker": "./src/runtime/worker.ts",
    "./testing": "./src/testing.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      },
      "./client": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./server": {
        "types": "./dist/runtime/server.d.ts",
        "default": "./dist/runtime/server.js"
      },
      "./worker": {
        "types": "./dist/runtime/worker.d.ts",
        "default": "./dist/runtime/worker.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "effect-tsgo tsc --noEmit && effect-tsgo tsc -p test/types",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-eventbridge": "^3.1169.0",
    "@aws-sdk/client-lambda": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/client-sqs": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/credential-provider-node": "^3.972.97",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@aws-sdk/s3-request-presigner": "^3.1169.0",
    "@ericminassian/platform-core": "workspace:*",
    "@smithy/hash-node": "^4.5.2",
    "@smithy/signature-v4": "^5.7.5",
    "jose": "^6.2.17"
  },
  "devDependencies": {
    "@effect/tsgo": "^0.69.0",
    "@ericminassian/platform-engine": "workspace:*",
    "@types/aws-lambda": "^8.10.164",
    "effect": "^4.1.4"
  },
  "peerDependencies": {
    "effect": "^4.1.4"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  }
}
