{
  "name": "@ericminassian/platform-core",
  "version": "0.3.0",
  "description": "Shared contracts for the platform: naming, manifest schema, bindings, telemetry, routing.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eric-minassian/platform.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth.ts",
    "./cloudfront-function": "./src/cloudfront-function.ts",
    "./platform-api": "./src/platform-api.ts",
    "./realtime": "./src/realtime.ts",
    "./router/decide.js": "./src/router/decide.js"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./auth": {
        "types": "./dist/auth.d.ts",
        "default": "./dist/auth.js"
      },
      "./cloudfront-function": {
        "types": "./dist/cloudfront-function.d.ts",
        "default": "./dist/cloudfront-function.js"
      },
      "./platform-api": {
        "types": "./dist/platform-api.d.ts",
        "default": "./dist/platform-api.js"
      },
      "./realtime": {
        "types": "./dist/realtime.d.ts",
        "default": "./dist/realtime.js"
      },
      "./router/decide.js": "./dist/router/decide.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && mkdir -p dist/router && cp src/router/decide.js src/router/decide.d.ts dist/router/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "effect": "^4.1.4"
  }
}
